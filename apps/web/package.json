{
  "name": "web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "bun test src --path-ignore-patterns 'src/immersive/__tests__/RoomModel.test.jsx' --path-ignore-patterns 'src/immersive/__tests__/RoomCamera.test.jsx' && bun test src/immersive/__tests__/RoomModel.test.jsx && bun test src/immersive/__tests__/RoomCamera.test.jsx",
    "dev:immersive": "VITE_IMMERSIVE_ENABLED=true vite",
    "test:immersive": "playwright test --config playwright.immersive.config.js",
    "test:immersive:chromium": "playwright test --config playwright.immersive.config.js --project chromium",
    "test:immersive:fallback": "playwright test --config playwright.fallback.config.js",
    "test:tour": "playwright test --config playwright.tour.config.js",
    "test:profile": "playwright test --config playwright.profile.config.js"
  },
  "dependencies": {
    "@fontsource/source-serif-4": "5.3.1",
    "@fontsource/source-sans-3": "5.3.1",
    "@time-capsule/game-engine": "workspace:*",
    "@time-capsule/ui": "workspace:*",
    "@react-three/fiber": "9.8.2",
    "three": "0.187.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^9.17.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "babel-plugin-transform-react-jsx": "^6.24.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.14.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.16",
    "vite": "^8.3.8"
  }
