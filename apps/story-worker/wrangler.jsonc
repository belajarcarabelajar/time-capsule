{
  "name": "time-capsule-story",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "STORY_USER_LIMIT",
      "namespace_id": "71001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "STORY_GLOBAL_LIMIT",
      "namespace_id": "71002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
